{
  "name": "puppeteer-proverbia-script",
  "version": "1.0.0",
  "description": "Puppeteer script to fetch the phrase of the day and return it as a JSON response",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prebuild": "rm -rf dist/",
    "build": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit"
  },
  "author": "Sebastian Barrenechea (https://github.com/barrenechea)",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/barrenechea/puppeteer-proverbia-script.git"
  },
  "packageManager": "npm@12.2.1",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "puppeteer": "^25.16.0"
  }
}
